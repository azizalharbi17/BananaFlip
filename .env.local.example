# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings → API). Server-side only — no NEXT_PUBLIC_ here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Shared secret for POST/GET /api/refresh (also a GitHub Actions secret)
# and /api/cron/trending. Vercel Cron sends it automatically as
# "Authorization: Bearer $CRON_SECRET" when this var is set on the project.
CRON_SECRET=GENERATE-A-LONG-RANDOM-STRING

# Trending auto-discovery (Hot Flips) — all optional, defaults shown.
# Floors a token's strongest trending pool must clear (USD).
# TRENDING_MIN_LIQUIDITY_USD=100000
# TRENDING_MIN_VOLUME_USD=100000
# Size of the trending set (1–30) and GeckoTerminal networks to scan.
# TRENDING_LIMIT=15
# TRENDING_NETWORKS=solana,base,eth,bsc
# Trending window GeckoTerminal ranks by: 5m | 1h | 6h | 24h.
# TRENDING_DURATION=24h
# Parallel token resolutions (logo uploads hit the Supabase pool) — max 3.
# TRENDING_CONCURRENCY=3
# Sanity ceiling — anything bigger is a major that slipped the dedupe.
# TRENDING_MAX_MCAP_USD=20000000000

# CryptoCompare (CoinDesk data) key for ROI full price history.
# Free after registration: https://developers.coindesk.com/
CRYPTOCOMPARE_API_KEY=YOUR-CRYPTOCOMPARE-KEY

# Optional CoinGecko free "demo" key — extra rate-limit headroom for
# pinned CoinGecko coins ($ANSEM). Works without one at the low volume
# here (refresh ~every 10 min + history cached). https://coingecko.com/
COINGECKO_API_KEY=YOUR-COINGECKO-DEMO-KEY

# Optional: canonical origin for metadata/sitemap.
# NEXT_PUBLIC_SITE_URL=https://bananaflip.io
