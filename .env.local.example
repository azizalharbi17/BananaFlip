# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings → API). Server-side only — no NEXT_PUBLIC_ here.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Shared secret for POST/GET /api/refresh (also a GitHub Actions secret).
CRON_SECRET=GENERATE-A-LONG-RANDOM-STRING

# Optional: canonical origin for metadata/sitemap.
# NEXT_PUBLIC_SITE_URL=https://bananaflip.io
